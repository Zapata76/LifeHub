{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {"files": ["/index.html", "/*.js", "/styles.css", "/styles/tail.css"]}
    },
    {
      "name": "lazy-assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {"files": ["/**"]}
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/api/**"]
}
