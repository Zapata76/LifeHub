# Life Hub deployment v1. Managed exclusively by update.py.
Options -Indexes -MultiViews
DirectoryIndex index.php
RewriteEngine On
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; frame-src 'self' https://calendar.google.com; connect-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; worker-src 'self'"
</IfModule>
RewriteBase /umbertini/
RewriteRule (^|/)\. - [F,END]
RewriteRule ^hosting\.php$ - [F,END,NC]
RewriteRule ^index\.php$ - [END]
RewriteRule ^ index.php [END]
